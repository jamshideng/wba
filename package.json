{
  "name": "wba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "tsx scripts/migrate-from-sheets.ts",
    "migrate:dry": "tsx scripts/migrate-from-sheets.ts --dry-run",
    "test": "tsx --test scripts/**/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:test": "bash supabase/run-local-test.sh",
    "db:start": "npx supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:stop": "npx supabase stop",
    "hisob": "tsx scripts/hisob-och.ts",
    "ishga": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ishga-tushir.ps1",
    "toxta": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/toxtat.ps1",
    "tekshir": "npm test && tsc --noEmit && eslint src scripts && bash supabase/run-local-test.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "googleapis": "^181.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
